{
  "name": "alterra",
  "version": "0.8.22",
  "private": true,
  "description": "PWA mobile de préparation au trail et à la montagne.",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.browser.js\"",
    "check": "npm run format:check && npm run lint && npm test",
    "release": "node tools/release.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
